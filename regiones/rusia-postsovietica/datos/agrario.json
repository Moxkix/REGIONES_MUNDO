 "fuente": "Banco Mundial, World Development Indicators (actualización de octubre de 2026)",
 "indicadores": {
  "empleo_agrario": {
   "nombre": "Empleo en agricultura (% del empleo total)",
   "codigo": "SL.AGR.EMPL.ZS",
   "fuente": "Banco Mundial, WDI (estimación modelizada de la OIT)",
   "explicacion": "Peso de la agricultura en el empleo. Contrasta Rusia, Bielorrusia o Kazajistán, con economías industriales o de recursos, con Moldavia, Tayikistán, Azerbaiyán o Georgia, donde la agricultura sigue ocupando a un tercio o más de los trabajadores. Las cifras son estimaciones modelizadas de la OIT; la de Ucrania no se actualiza desde 2021.",
   "decimales": 1
  },
  "pib_agrario": {
   "nombre": "Agricultura, silvicultura y pesca, valor añadido (% del PIB)",
   "codigo": "NV.AGR.TOTL.ZS",
   "fuente": "Banco Mundial, WDI (cuentas nacionales del Banco Mundial y de la OCDE)",
   "explicacion": "Peso de la agricultura, la silvicultura y la pesca en el PIB. Es mucho menor que su peso en el empleo porque la productividad agraria es baja: en Moldavia o Georgia la agricultura ocupa a un tercio de los trabajadores y aporta menos del 8 % del PIB.",
   "decimales": 1
  },
  "rendimiento_cereales": {
   "nombre": "Rendimiento de los cereales (kg por hectárea)",
   "codigo": "AG.YLD.CREL.KG",
   "fuente": "Banco Mundial, WDI (FAO)",
   "explicacion": "Kilos de cereal cosechados por hectárea. Kazajistán y Turkmenistán están por debajo de 2.000 kg/ha por la aridez de las estepas de secano; Uzbekistán y Tayikistán superan a Rusia porque buena parte de su cereal es de regadío. Varía mucho de un año a otro con la meteorología.",
   "decimales": 0
  },
  "tierra_cultivable": {
   "nombre": "Tierra cultivable (hectáreas por persona)",
   "codigo": "AG.LND.ARBL.HA.PC",
   "fuente": "Banco Mundial, WDI (FAO y estimaciones de población del Banco Mundial)",
   "explicacion": "Hectáreas de tierra cultivable por habitante. Kazajistán, Rusia, Ucrania y Moldavia disponen de mucha tierra por persona (las tierras negras y las estepas cerealistas); los oasis de Asia central (Uzbekistán, Tayikistán) muy poca, porque su población crece y el cultivo depende del riego.",
   "decimales": 2
  },
  "bosque": {
   "nombre": "Superficie forestal (% de la superficie de tierra)",
   "codigo": "AG.LND.FRST.ZS",
   "fuente": "Banco Mundial, WDI (FAO, Evaluación de los Recursos Forestales)",
   "explicacion": "La mitad de Rusia está cubierta de bosque, sobre todo la taiga siberiana, la mayor masa forestal del planeta. En Asia central el bosque apenas existe fuera de las montañas.",
   "decimales": 1
  }
 },
